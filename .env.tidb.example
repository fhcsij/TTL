# Copy the exact host, port and prefixed username from TiDB's Connect dialog.
# Add these keys to Vercel's Production environment. Do not commit real values.
DB_DRIVER=mysql
DB_HOST=your-host-from-tidb-connect
DB_PORT=4000
DB_USER=your-prefix.your-user
DB_PASSWORD=
DB_NAME=twotimelight
DB_SSL=true
DB_SSL_VERIFY=true
# Optional: absolute path to a trusted CA bundle; the runtime otherwise detects it.
DB_SSL_CA=
DB_SESSION_STORAGE=database
